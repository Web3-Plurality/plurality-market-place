# =====================================================================
# plurality-market-place — example env. Copy to .env and fill in.
# This is the unified Marketplace UI (Studio + C2C + BYOK Agent).
# =====================================================================

# ---- Backend (market-backend, NOT prod backend) ----
VITE_APP_API_BASE_URL=http://localhost:5001

# ---- DEPRECATED (UI is wallet-only). Will be removed in Phase 1
#      together with src/utils/env.ts STYTCH exports. Leaving as empty
#      keys for now so existing imports don't crash on undefined. ----
VITE_APP_PUBLIC_STYTCH_PROJECT_ID=
VITE_APP_PUBLIC_STYTCH_TOKEN=

# ---- BYOK Agent (Phase 4) ----
# Streamable-HTTP endpoint for the market MCP server.
# In production this should be the Traefik-fronted URL (CORS lives at the proxy).
VITE_APP_MCP_URL=http://localhost:5051/mcp

# Where to fetch `.well-known/oauth-protected-resource/mcp` and run DCR.
# Production: same host as VITE_APP_MCP_URL (Traefik routes both paths).
# Local dev: backend host (e.g. http://localhost:5001), since the MCP server
# itself does not serve discovery — only the backend does.
# Defaults to VITE_APP_API_BASE_URL when unset.
# VITE_APP_MCP_DISCOVERY_URL=http://localhost:5001
