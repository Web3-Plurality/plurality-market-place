# =====================================================================
# plurality-market-place — DEV/pre-release build env.
# CI copies this to .env.production before `npm run build`, so these
# values are baked into the pre-release image.
# =====================================================================

VITE_APP_PUBLIC_DOMAIN=dev.marketplace.plurality.network

# ---- Backend (market-backend) ----
VITE_APP_API_BASE_URL=https://${VITE_APP_PUBLIC_DOMAIN}/api

# ---- BYOK Agent ----
# Streamable-HTTP endpoint for the market MCP server, fronted by Traefik.
VITE_APP_MCP_URL=https://${VITE_APP_PUBLIC_DOMAIN}/mcp

# ---- Chain ----
# Sapphire network for wallet writes + SIWE: 'testnet' or 'mainnet'.
VITE_APP_CHAIN=testnet

# Keep new line at the bottom always
